# Copie para .env na raiz do projeto. Valores já exportados têm prioridade.
# Os caminhos abaixo correspondem ao downloader executado com esta configuração.
IVI_DATA_DIR=.ivi
IVI_CONTEXT_TOKENS=1024
IVI_CPU_THREADS=2
IVI_PORT=8765

# Deixe em branco para iniciar sem o componente; a interface informa a ausência.
# Estes arquivos NÃO acompanham o projeto. Use a preparação pela interface.
IVI_LLM_MODEL=.ivi/models/llm/qwen2.5-0.5b-instruct-q4_k_m.gguf
IVI_STT_MODEL=.ivi/models/stt
IVI_TTS_MODEL=.ivi/models/tts/pt/pt_BR/faber/medium/pt_BR-faber-medium.onnx
IVI_TTS_CONFIG=.ivi/models/tts/pt/pt_BR/faber/medium/pt_BR-faber-medium.onnx.json

# Opcional para quem já possui um motor nativo. A preparação guiada salva o caminho automaticamente.
# IVI_LLM_SERVER_EXE=C:/caminho/llama-server.exe
